# ============================================================
# VaultMind Environment Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit the .env file to Git!
# ============================================================

# ---- LLM Provider Selection ----
# Options: "ollama", "openai", "azure", "gemini"
LLM_PROVIDER=ollama

# ---- Ollama Configuration (Local LLM) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- OpenAI Configuration (Cloud LLM - Optional) ----
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-4o

# ---- Azure OpenAI Configuration (Enterprise Cloud - Optional) ----
# AZURE_OPENAI_API_KEY=your-api-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_MODEL=gpt-4o

# ---- Database ----
DATABASE_URL=postgresql://vaultmind:vaultmind@localhost:5432/vaultmind

# ---- Vector Database ----
# Options: "chroma", "qdrant"
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_DIR=./chroma_db

# ---- Application ----
APP_NAME=VaultMind
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-secret-key

# ---- CORS (Frontend URL) ----
FRONTEND_URL=http://localhost:3000
